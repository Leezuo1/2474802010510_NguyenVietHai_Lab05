        {
          "name": "Request_4: DELETE User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204 No Content\", () => pm.response.to.have.status(204));\r",
                  "pm.test(\"Body rỗng\", () => pm.expect(pm.response.text()).to.be.empty);\r",
                  "\r",
                  "postman.setNextRequest(\"Request_7: GET Deleted User\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
