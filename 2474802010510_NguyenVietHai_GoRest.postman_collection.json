  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Request_1: POST Create User (DDT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseEmail = pm.iterationData.get(\"email\");\r",
                  "const uniqueEmail = baseEmail.replace(\"@\", \".\" + Date.now() + \"@\");\r",
                  "pm.environment.set(\"userEmail\", uniqueEmail);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));\r",
                  "\r",
                  "const res = pm.response.json();\r",
                  "pm.test(\"Dữ liệu trả về khớp file CSV\", () => {\r",
                  "    pm.expect(res.name).to.eql(pm.iterationData.get(\"name\"));\r",
                  "    pm.expect(res.gender).to.eql(pm.iterationData.get(\"gender\"));\r",
                  "    pm.expect(res.email).to.eql(pm.environment.get(\"userEmail\"));\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"userId\", res.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{userEmail}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request_2: GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"Đúng user vừa tạo\", () => {\r",
                  "    pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get(\"userId\")));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request_3: PATCH User Inactive",
